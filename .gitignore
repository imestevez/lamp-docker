# Ignore local environment files, but keep the documented template.
*.env*
!.env.example

# Ignore local database projects, but keep the test initialization file.
/db/*
!/db/init/
/db/init/*
!/db/init/01-test.sql

# Utility scripts are local and are not distributed with the repository.
/utils/

# Ignore local applications, but keep the smoke-test files.
/www/*
!/www/index.php
!/www/dbtest.php
